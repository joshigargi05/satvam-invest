{
  "name": "satvam-invest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\"",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "mobile:build": "vite build && npx cap sync",
    "android:init": "npm install @capacitor/core @capacitor/cli @capacitor/android && npx cap add android",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "ios:init": "npm install @capacitor/core @capacitor/cli @capacitor/ios && npx cap add ios",
    "ios:sync": "vite build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "yahoo-finance2": "^3.15.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
