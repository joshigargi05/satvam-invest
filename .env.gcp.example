# ============================================================================
# VestraAI (satvam-invest) — GCP Cloud Run + Cloud SQL Environment Template
# ============================================================================

# 1. Server Runtime
NODE_ENV=production
PORT=8080
SERVE_STATIC=true

# 2. GCP Cloud SQL for PostgreSQL 16 Connection
# Option A: Standard Cloud Run Unix Socket (Recommended on GCP Cloud Run)
INSTANCE_UNIX_SOCKET=/cloudsql/YOUR_GCP_PROJECT_ID:us-central1:vestraai-postgres
DB_USER=vestra_app
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD
DB_NAME=vestraai
DB_POOL_MAX=10
AUTO_MIGRATE_SCHEMA=true

# Option B: Direct PostgreSQL Connection URI (Local / Cloud SQL Proxy / AlloyDB)
# DATABASE_URL=postgresql://vestra_app:YOUR_PASSWORD@localhost:5432/vestraai

# 3. Authentication, Google OAuth 2.0 & Email OTP (SMTP / Gmail App Password)
JWT_SECRET=replace-with-64-byte-cryptographic-secret-from-gcp-secret-manager
GOOGLE_CLIENT_ID=your_gcp_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_gcp_oauth_client_id.apps.googleusercontent.com

# Gmail / Custom SMTP for Real 6-Digit Email OTP Delivery (No custom domain required with Gmail!)
# How to generate a 16-char Gmail App Password:
# Google Account -> Security -> 2-Step Verification -> App passwords -> Create "VestraAI"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="VestraAI Security" <your.email@gmail.com>

# 4. Market Data & AI Intelligence Providers (Store in GCP Secret Manager)
FINNHUB_API_KEY=your_finnhub_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
GROK_API_KEY=your_grok_api_key
